DATABASE_URL=postgres://dbmp:dbmp_dev_password@localhost:5433/dbmp_internal?sslmode=disable
TARGET_DATABASE_URL=postgres://dbmp:dbmp_dev_password@localhost:5433/dbmp_target?sslmode=disable
TEST_PLATFORM_DATABASE_URL=postgres://dbmp:dbmp_dev_password@127.0.0.1:5433/dbmp_platform_test?sslmode=disable
TEST_TARGET_DATABASE_URL=postgres://dbmp:dbmp_dev_password@127.0.0.1:5433/dbmp_target_test?sslmode=disable

# Pengaturan aplikasi lokal
APP_ENV=development
APP_ADDR=:8080

# Buat admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=80808080

# Di development dapat dikosongkan (kunci bawaan hanya untuk penggunaan lokal)
# Untuk environment selain lokal, isi kunci acak 32 byte dalam format base64
APP_SECRET_KEY=